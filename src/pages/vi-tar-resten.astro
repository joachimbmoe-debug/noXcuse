---
// `/vi-tar-resten` — spor 2. Fase 3 steg 8. All tekst kopiert ordrett fra
// 08_SEGMENTSIDER_TEKST.md §3. Skjemafelt fra 03_SALGSFUNNEL.md §4 (8 felt).
//
// §7-mikroteksten ("Skal vi komme og se på tomta?") er verbatim fra
// §7-tabellen (Sluttseksjon-CTA, spor 2) — plassert som overskrift for
// "Hva vi må vite om tomta"-seksjonen, samme tomtekartlegging-tema. Samme
// tolkningsprinsipp som på /tomta-er-klar, se den filens kommentar.
//
// "Hva vi kan ta"-seksjonen er BLOKKERT (⚠️ BLOKKERING i kilden) — gates på
// config.TJENESTELISTE_KLAR (i dag false), viser ventetekst kopiert ordrett.
// Ingen tjenestenavn nevnt før flagget er true, se CLAUDE.md-regel.
import Side from '../layouts/Side.astro';
import SegmentBytte from '../components/SegmentBytte.astro';
import { config } from '../config';
import { faktaEllerPlassholder } from '../lib/bekreft';

const importselskap = faktaEllerPlassholder(config.IMPORTSELSKAP, 'Importselskapets navn');
---

<Side
  title="noXcuse — Du har tomta. Vi tar resten."
  description="Du vil ikke være byggherre. Vi tar huset og jobben på tomta, med én kontakt gjennom hele løpet."
>
  <section class="hero reveal" data-reveal aria-labelledby="hero-h1">
    <div class="hero__inner">
      <h1 id="hero-h1" class="hero__h1">Du har tomta. Vi tar resten.</h1>
      <p class="hero__ingress">
        Du vil ikke være byggherre, koordinere fag eller finne ut hvem som har ansvaret når noe
        ikke stemmer. Da tar vi huset og jobben på tomta, og du har én kontakt gjennom hele
        løpet.
      </p>
    </div>
  </section>

  {/* §3 Seksjon: Hvordan det prises */}
  <section class="prising reveal" data-reveal aria-labelledby="prising-h2">
    <div class="prising__inner">
      <h2 id="prising-h2" class="prising__h2">Hvordan det prises</h2>
      <p class="prising__tekst">Prisen bygges i to deler, og du ser begge:</p>
      <ol class="prising__liste">
        <li><strong>Huset — levert og montert.</strong> Nivå 2 i kostnadstrappen. Fast pris.</li>
        <li><strong>Jobben på tomta.</strong> Hver tjeneste med egen pris, så du ser hva hver enkelt del koster.</li>
      </ol>
      <p class="prising__tekst">
        Du får ikke én stor sum uten forklaring. Du får to tall og en spesifikasjon, og du kan
        stryke det du ikke vil ha.
      </p>
    </div>
  </section>

  {/* §3 Seksjon: Hva vi kan ta — blokkert til tjenestelisten finnes */}
  <section class="hva-vi-tar reveal" data-reveal aria-labelledby="hva-vi-tar-h2">
    <div class="hva-vi-tar__inner">
      <h2 id="hva-vi-tar-h2" class="hva-vi-tar__h2">Hva vi kan ta</h2>
      {config.TJENESTELISTE_KLAR ? (
        <p class="hva-vi-tar__tekst">Tjenestelisten er publisert — tabellen kommer her.</p>
      ) : (
        <div class="hva-vi-tar__venter">
          <p><strong>Tjenestelisten er ikke publisert ennå.</strong></p>
          <p>
            Importselskapet leverer transport, montasje og øvrige tjenester på tomt. Nøyaktig
            hvilke poster som inngår, og hva hver av dem koster, publiserer vi når listen er
            endelig — ikke før.
          </p>
          <p>
            Vil du vite hva vi kan ta på din tomt i mellomtiden, sier vi det på befaring. Da
            snakker vi om din tomt, ikke om en liste.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* §3 Seksjon: Hva vi må vite om tomta — §7 sluttseksjon-CTA som overskrift, se filkommentar */}
  <section class="tomta reveal" data-reveal aria-labelledby="tomta-h2">
    <div class="tomta__inner">
      <h2 id="tomta-h2" class="tomta__h2">Skal vi komme og se på tomta?</h2>
      <p class="tomta__lead">Før vi kan si noe om jobben, må vi vite hva slags tomt vi kommer til:</p>
      <ul class="tomta__liste">
        <li>Er den opparbeidet, delvis opparbeidet, eller råtomt?</li>
        <li>Har du byggetillatelse, har du søkt, eller har du ikke begynt?</li>
        <li>Hvor langt er det til vann, avløp og strøm?</li>
        <li>Kommer trailer og kran fram?</li>
      </ul>
      <p class="tomta__tekst">Vi gjetter ikke på noe av dette. Vi kommer og ser.</p>
    </div>
  </section>

  {/* §3 Seksjon: Hvem du har avtale med */}
  <section class="avtalepart reveal" data-reveal aria-labelledby="avtalepart-h2">
    <div class="avtalepart__inner">
      <h2 id="avtalepart-h2" class="avtalepart__h2">Hvem du har avtale med</h2>
      <p class="avtalepart__tekst">
        Du kjøper huset av noXcuse, og vi eier kundeforholdet hele veien. Kontrakten inngås med
        {' '}{importselskap}, som står for import, transport, montasje og tjenestene på tomta.
      </p>
      <p class="avtalepart__tekst">
        <strong>Én avtalepart for hele leveransen.</strong> Du skal ikke måtte lete i kontrakten
        for å finne ut hvem du ringer, og du skal ikke havne mellom to selskaper som peker på
        hverandre.
      </p>
      <p class="avtalepart__info">
        Til opplysning: bustadoppføringslova gjelder ved forbrukerkjøp av bolig, med
        garantistillelse etter § 12 og 5 års reklamasjonsrett.
      </p>
    </div>
  </section>

  {/* §3 Skjema — 8 felt. Statisk markup, ingen POST/validering (Fase 4). */}
  <section class="skjema reveal" data-reveal aria-labelledby="skjema-h2">
    <div class="skjema__inner">
      <h2 id="skjema-h2" class="skjema__h2">Få pris på hus og hele jobben</h2>

      <form
        class="skjema__form"
        name="vi-tar-resten"
        method="POST"
        data-netlify="true"
        netlify-honeypot="firmanavn"
        action="/takk"
      >
        <input type="hidden" name="form-name" value="vi-tar-resten" />
        <input type="hidden" name="segment" value="2" />

        <div class="skjema__honeypot" aria-hidden="true">
          <label for="firmanavn-2">La stå tomt</label>
          <input type="text" id="firmanavn-2" name="firmanavn" tabindex="-1" autocomplete="off" />
        </div>

        <div class="skjema__felt">
          <label for="navn-2">Navn</label>
          <input type="text" id="navn-2" name="navn" autocomplete="name" required />
        </div>

        <div class="skjema__felt">
          <label for="telefon-2">Telefon</label>
          <input type="tel" id="telefon-2" name="telefon" autocomplete="tel" required />
        </div>

        <div class="skjema__felt">
          <label for="epost-2">E-post</label>
          <input type="email" id="epost-2" name="epost" autocomplete="email" required />
        </div>

        <div class="skjema__felt">
          <label for="adresse-2">Adresse eller gnr/bnr</label>
          <input type="text" id="adresse-2" name="adresse" required />
        </div>

        <div class="skjema__felt">
          <label for="kommune-2">Kommune</label>
          <input type="text" id="kommune-2" name="kommune" autocomplete="address-level2" required />
        </div>

        <fieldset class="skjema__fieldset">
          <legend>Er tomta opparbeidet?</legend>
          <label class="skjema__radio"><input type="radio" name="opparbeidet" value="ja" required /> Ja</label>
          <label class="skjema__radio"><input type="radio" name="opparbeidet" value="delvis" /> Delvis</label>
          <label class="skjema__radio"><input type="radio" name="opparbeidet" value="raatomt" /> Nei, råtomt</label>
        </fieldset>

        <fieldset class="skjema__fieldset">
          <legend>Har du byggetillatelse?</legend>
          <label class="skjema__radio"><input type="radio" name="byggetillatelse" value="ja" required /> Ja</label>
          <label class="skjema__radio"><input type="radio" name="byggetillatelse" value="soekt" /> Søkt</label>
          <label class="skjema__radio"><input type="radio" name="byggetillatelse" value="nei" /> Nei</label>
        </fieldset>

        <div class="skjema__felt">
          <label for="fritekst-2">Hva ser du for deg?</label>
          <textarea id="fritekst-2" name="hva-ser-du-for-deg" rows="4"></textarea>
        </div>

        <div class="skjema__samtykke">
          <input type="checkbox" id="samtykke-2" name="samtykke" required />
          <label for="samtykke-2">
            Ja, noXcuse kan kontakte meg om denne henvendelsen. Vi lagrer opplysningene så lenge
            det er nødvendig for å følge den opp, og deler dem ikke med andre enn selskapene som
            er involvert i leveransen. Du kan be om innsyn eller sletting når som helst.
          </label>
        </div>

        <button type="submit" class="skjema__knapp">Send inn</button>

        <p class="skjema__under">
          Vi ringer for å avtale befaring. Uten å ha sett tomta kan vi ikke gi deg et tall vi kan
          stå for, og et tall vi ikke kan stå for, er ikke verdt noe.
        </p>
      </form>
    </div>
  </section>

  <SegmentBytte gjeldende="vi-tar-resten" />
</Side>

<style>
  .hero {
    background-color: var(--color-bomull);
  }
  .hero__inner {
    max-width: var(--spacing-bredde);
    margin-inline: auto;
    padding: var(--spacing-rom-6) var(--spacing-side-x) var(--spacing-rom-4);
  }
  .hero__h1 {
    font-size: var(--text-h2);
    color: var(--color-marine);
    max-width: 24ch;
    margin: 0 0 var(--spacing-rom-3);
  }
  .hero__ingress {
    font-size: var(--text-stor);
    color: var(--color-stein);
    max-width: var(--spacing-bredde-tekst);
    margin: 0;
  }

  .prising {
    background-color: var(--color-lin);
  }
  .prising__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .prising__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .prising__tekst {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .prising__liste {
    margin: 0 0 var(--spacing-rom-2);
    padding-left: var(--spacing-rom-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .prising__liste li {
    font-size: var(--text-brod);
    color: var(--color-marine);
  }

  .hva-vi-tar {
    background-color: var(--color-bomull);
  }
  .hva-vi-tar__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .hva-vi-tar__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-3);
  }
  .hva-vi-tar__venter {
    background-color: var(--color-lin);
    border: 1px solid var(--color-kant);
    border-radius: var(--radius-kort);
    padding: var(--spacing-rom-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-2);
  }
  .hva-vi-tar__venter p {
    margin: 0;
    font-size: var(--text-brod);
    color: var(--color-marine);
  }

  .tomta {
    background-color: var(--color-lin);
  }
  .tomta__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .tomta__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .tomta__lead {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .tomta__liste {
    margin: 0 0 var(--spacing-rom-2);
    padding-left: var(--spacing-rom-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .tomta__liste li {
    font-size: var(--text-brod);
    color: var(--color-marine);
  }
  .tomta__tekst {
    font-size: var(--text-brod);
    color: var(--color-stein);
    margin: 0;
  }

  .avtalepart {
    background-color: var(--color-bomull);
  }
  .avtalepart__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .avtalepart__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .avtalepart__tekst {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .avtalepart__info {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: 0;
  }

  .skjema {
    background-color: var(--color-lin);
  }
  .skjema__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x) var(--spacing-rom-6);
  }
  .skjema__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-3);
  }
  .skjema__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-2);
  }
  .skjema__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .skjema__felt {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .skjema__felt label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-liten);
    color: var(--color-marine);
  }
  .skjema__felt input,
  .skjema__felt textarea {
    padding: var(--spacing-rom-1) var(--spacing-rom-2);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-knapp);
    background-color: var(--color-bomull);
    color: var(--color-marine);
    font-size: var(--text-brod);
    font-family: var(--font-tekst);
  }
  .skjema__felt input {
    min-height: 48px;
  }
  .skjema__felt textarea {
    resize: vertical;
  }
  .skjema__fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-rom-2);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-knapp);
    padding: var(--spacing-rom-2);
  }
  .skjema__fieldset legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-liten);
    color: var(--color-marine);
    padding: 0 var(--spacing-rom-1);
  }
  .skjema__radio {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-rom-1);
    font-size: var(--text-brod);
    color: var(--color-marine);
  }
  .skjema__samtykke {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-rom-1);
    margin-top: var(--spacing-rom-1);
  }
  .skjema__samtykke input {
    margin-top: 0.3em;
    flex-shrink: 0;
  }
  .skjema__samtykke label {
    font-size: var(--text-mikro);
    color: var(--color-stein);
  }
  .skjema__knapp {
    min-height: 48px;
    padding: var(--spacing-rom-2) var(--spacing-rom-3);
    border: 1px solid transparent;
    border-radius: var(--radius-knapp);
    background-color: var(--color-marine);
    color: var(--color-bomull);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-brod);
    cursor: pointer;
    transition: background-color var(--tid-nor) var(--ease-brand);
  }
  .skjema__knapp:hover {
    background-color: color-mix(in srgb, var(--color-marine) 88%, black);
  }
  .skjema__under {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: 0;
  }
</style>
