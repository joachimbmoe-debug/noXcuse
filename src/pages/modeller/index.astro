---
// Modelloversikt `/modeller` — fase 3 steg 10, 01_BYGGEPLAN.md.
// Tekst opprinnelig kopiert ordrett fra 04_TEKST_ALLE_SIDER.md §2
// "Modelloversikt /modeller" — tilpasset 2026-08-12 til å vise kun
// helårsbolig-kategorien, se D16 under.
//
// Én mal, mange innganger: alle kortene under kommer fra src/data/modeller/*.json.
// Ny modell = ny JSON-fil i den mappa. Ingen kodeendring her eller i [slug].astro.
//
// D16 (Joachim, 2026-08-12): «Modellene våre» i menyen døpt om til «Våre hus»,
// med en ny egen «Våre hytter»-side (src/pages/vare-hytter.astro) rett ved
// siden av. Denne siden filtrerer nå til kategori === 'helaarsbolig' — det er
// den kategorisplitten §2 sin opprinnelige filter-UI-plan (Alle · Helårsbolig
// · Hytte · Utleieenhet, bevisst utsatt til kategoriene faktisk fantes) endte
// opp med å bli løst som, bare via egne sider i stedet for en filterknapp.
// «Utleieenhet»-kategorien (modell-c) er IKKE inkludert på noen av de to nye
// sidene — verken «hus» eller «hytte» passer semantisk, og Joachim ba ikke om
// en tredje meny-kategori. Fortsatt nåbar direkte på /modeller/modell-c, bare
// ikke listet noe sted. Flagg til Joachim om en tredje kategori-side trengs.
import Side from '../../layouts/Side.astro';
import ModellKort from '../../components/ModellKort.astro';

interface Modell {
  slug: string;
  navn: string | null;
  kvadratmeter: number | null;
  kategori: 'helaarsbolig' | 'hytte' | 'utleieenhet';
}

const moduler = import.meta.glob<{ default: Modell }>('../../data/modeller/*.json', {
  eager: true,
});

const modeller = Object.values(moduler)
  .map((modul) => modul.default)
  .filter((modell) => modell.kategori === 'helaarsbolig')
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<Side
  title="noXcuse — Våre hus"
  description="Komplette boenheter inntil 49 m². Alle bygges ferdig i fabrikk og leveres på trailer. Alle priser står med leveransenivå."
>
  <section class="modeller reveal" data-reveal aria-labelledby="modeller-h1">
    <div class="modeller__inner">
      <h1 id="modeller-h1" class="modeller__h1">Våre hus</h1>
      <p class="modeller__ingress">
        Komplette boenheter inntil 49 m². Alle bygges ferdig i fabrikk og leveres på trailer.
        Alle priser står med leveransenivå.
      </p>

      <div class="modeller__grid">
        {
          modeller.map((modell) => (
            <ModellKort
              navn={modell.navn}
              kvadratmeter={modell.kvadratmeter}
              bildeAlt="Plassholder — modellbilde fra Husvik er ikke levert ennå"
              href={`/modeller/${modell.slug}`}
            />
          ))
        }
      </div>

      <p class="modeller__hyttespor">
        Ser du etter hytte? <a href="/vare-hytter">Se hyttene våre</a> — bygget etter samme
        standard som husene.
      </p>
    </div>
  </section>
</Side>

<style>
  .modeller {
    background-color: var(--color-bomull);
  }
  .modeller__inner {
    max-width: var(--spacing-bredde);
    margin-inline: auto;
    padding: var(--spacing-seksjon-y) var(--spacing-side-x);
  }
  .modeller__h1 {
    font-size: var(--text-h2);
    color: var(--color-marine);
    max-width: 20ch;
    margin: 0 0 var(--spacing-rom-2);
  }
  .modeller__ingress {
    font-size: var(--text-stor);
    color: var(--color-stein);
    max-width: var(--spacing-bredde-tekst);
    margin: 0 0 var(--spacing-rom-5);
  }
  .modeller__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-rom-3);
    margin-bottom: var(--spacing-rom-5);
  }
  @media (min-width: 640px) {
    .modeller__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .modeller__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .modeller__hyttespor {
    font-size: var(--text-liten);
    color: var(--color-stein);
    max-width: var(--spacing-bredde-tekst);
    margin: 0;
  }
</style>
