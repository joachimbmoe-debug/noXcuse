---
// `/egen-entreprenor` — spor 3. Fase 3 steg 8. All tekst kopiert ordrett fra
// 08_SEGMENTSIDER_TEKST.md §4. Skjemafelt fra 03_SALGSFUNNEL.md §5 (7 felt).
//
// §7-mikroteksten ("Skal vi ta grensesnittet med entreprenøren din?") er
// verbatim fra §7-tabellen (Sluttseksjon-CTA, spor 3) — plassert som
// overskrift for "Grensesnittet mot entreprenøren din"-seksjonen. Samme
// tolkningsprinsipp som på /tomta-er-klar og /vi-tar-resten.
//
// "Sett sammen din leveranse"-seksjonen er BLOKKERT (⚠️ BLOKKERING i kilden) —
// gates på config.TJENESTELISTE_KLAR (i dag false), viser ventetekst kopiert
// ordrett, og bytter avkrysningsfeltet i skjemaet med fritekstfeltet
// «Hva trenger du fra oss?» per kildens eksplisitte instruks.
//
// RETTET av LEAD etter gjennomgang av N9-rapporten (se .foreman/ledger.md, Kjøring 3):
// §4 sier eksplisitt "Dette er en reell forpliktelse. Bekreft med Erik at rutinen
// finnes før seksjonen publiseres — ellers er den et løfte selskapet ikke kan holde,
// og det er akkurat det navnet lover at ikke skjer." Det er ikke en flagget
// vurdering å la stå åpen — kilden selv sier ikke publiser før bekreftet, og
// config.GRENSESNITT_RUTINE finnes allerede for nøyaktig dette. Gatet nedenfor,
// samme mønster som TJENESTELISTE_KLAR over.
import Side from '../layouts/Side.astro';
import SegmentBytte from '../components/SegmentBytte.astro';
import { config } from '../config';
---

<Side
  title="noXcuse — Du har tomt og egen entreprenør"
  description="Da trenger du huset — og kanskje noen få ting fra oss. Du skal ikke betale for en graver du allerede har."
>
  <section class="hero reveal" data-reveal aria-labelledby="hero-h1">
    <div class="hero__inner">
      <h1 id="hero-h1" class="hero__h1">Du har tomt og egen entreprenør</h1>
      <p class="hero__ingress">
        Da trenger du huset — og kanskje noen få ting fra oss. Du skal ikke betale for en graver
        du allerede har.
      </p>
    </div>
  </section>

  {/* §4 Seksjon: Sett sammen din leveranse — blokkert til tjenestelisten finnes */}
  <section class="leveranse reveal" data-reveal aria-labelledby="leveranse-h2">
    <div class="leveranse__inner">
      <h2 id="leveranse-h2" class="leveranse__h2">Sett sammen din leveranse</h2>
      <p class="leveranse__tekst">
        Huset prises på nivå 2: levert og montert. Alt annet plukker du fra tjenestelisten, post
        for post, med pris på hver.
      </p>
      <p class="leveranse__tekst">
        Tar entreprenøren din grunnarbeidet, stryker du grunnarbeid. Har du egen kran, stryker du
        kran. Du betaler for det du bruker.
      </p>

      {config.TJENESTELISTE_KLAR ? (
        <p class="leveranse__tekst">Tjenestelisten er publisert — avkrysningslisten kommer her.</p>
      ) : (
        <div class="leveranse__venter">
          <p>
            <strong>Tjenestelisten er ikke publisert ennå.</strong> Vi publiserer den med pris på
            hver post når den er endelig. Til da: si i skjemaet hva du trenger, så svarer vi
            konkret på det.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* §4 Seksjon: Grensesnittet mot entreprenøren din — §7 sluttseksjon-CTA som overskrift.
      Gatet på GRENSESNITT_RUTINE: kilden sier eksplisitt ikke publiser før Erik har
      bekreftet at rutinen faktisk finnes. */}
  <section class="grensesnitt reveal" data-reveal aria-labelledby="grensesnitt-h2">
    <div class="grensesnitt__inner">
      <h2 id="grensesnitt-h2" class="grensesnitt__h2">Skal vi ta grensesnittet med entreprenøren din?</h2>
      {config.GRENSESNITT_RUTINE ? (
        <>
          <p class="grensesnitt__lead">
            Det som pleier å gå galt når to parter deler en jobb, er overgangene. Derfor avklarer
            vi tre ting skriftlig før leveranse:
          </p>
          <ol class="grensesnitt__liste">
            <li><strong>Hva fundamentet må tåle, og når det må være ferdig.</strong> Vi gir spesifikasjonen til entreprenøren din.</li>
            <li><strong>Hvem som gjør tilkoblingene</strong> — vann, avløp, strøm, fiber.</li>
            <li><strong>Hvem som er på tomta på leveringsdagen</strong>, og hvem som har ansvaret for hva den dagen.</li>
          </ol>
          <p class="grensesnitt__tekst">
            Entreprenøren din får dette skriftlig fra oss, ikke muntlig via deg.
          </p>
        </>
      ) : (
        <div class="grensesnitt__venter">
          <p>
            <strong>Fortell oss om entreprenøren din i skjemaet under</strong>, så avklarer vi
            grensesnittet direkte med deg og ham.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* §4 Seksjon: Hva garantien dekker når andre har gjort deler av jobben */}
  <section class="garanti reveal" data-reveal aria-labelledby="garanti-h2">
    <div class="garanti__inner">
      <h2 id="garanti-h2" class="garanti__h2">Hva garantien dekker når andre har gjort deler av jobben</h2>
      <p class="garanti__tekst">
        Garantien etter bustadoppføringslova § 12 dekker huset og det vi har levert. Den dekker
        ikke arbeid entreprenøren din har utført.
      </p>
      <p class="garanti__tekst">
        Vi sier dette høyt nå, ikke når noe har gått galt. Grensen skrives inn i kontrakten, så
        begge parter vet hvor den går.
      </p>
    </div>
  </section>

  {/* §4 Skjema — 7 felt. Statisk markup, ingen POST/validering (Fase 4). */}
  <section class="skjema reveal" data-reveal aria-labelledby="skjema-h2">
    <div class="skjema__inner">
      <h2 id="skjema-h2" class="skjema__h2">Sett sammen din leveranse</h2>

      <form
        class="skjema__form"
        name="egen-entreprenor"
        method="POST"
        data-netlify="true"
        netlify-honeypot="firmanavn"
        action="/takk"
      >
        <input type="hidden" name="form-name" value="egen-entreprenor" />
        <input type="hidden" name="segment" value="3" />

        <div class="skjema__honeypot" aria-hidden="true">
          <label for="firmanavn-3">La stå tomt</label>
          <input type="text" id="firmanavn-3" name="firmanavn" tabindex="-1" autocomplete="off" />
        </div>

        <div class="skjema__felt">
          <label for="navn-3">Navn</label>
          <input type="text" id="navn-3" name="navn" autocomplete="name" required />
        </div>

        <div class="skjema__felt">
          <label for="telefon-3">Telefon</label>
          <input type="tel" id="telefon-3" name="telefon" autocomplete="tel" required />
        </div>

        <div class="skjema__felt">
          <label for="epost-3">E-post</label>
          <input type="email" id="epost-3" name="epost" autocomplete="email" required />
        </div>

        <div class="skjema__felt">
          <label for="adresse-3">Adresse eller gnr/bnr</label>
          <input type="text" id="adresse-3" name="adresse" required />
        </div>

        <div class="skjema__felt">
          <label for="kommune-3">Kommune</label>
          <input type="text" id="kommune-3" name="kommune" autocomplete="address-level2" required />
        </div>

        {/* Avkrysningsfeltet kan ikke skrives før tjenestelisten finnes (§4,
            ⚠️ BLOKKERING). TJENESTELISTE_KLAR er false i dag → fritekstfelt. */}
        {config.TJENESTELISTE_KLAR ? (
          <div class="skjema__felt">
            <label>Hvilke tjenester trenger du?</label>
            <p class="skjema__venter">Tjenestelisten er publisert — avkrysningsboksene kommer her.</p>
          </div>
        ) : (
          <div class="skjema__felt">
            <label for="tjenester-fritekst-3">Hva trenger du fra oss?</label>
            <textarea id="tjenester-fritekst-3" name="tjenester-fritekst" rows="4"></textarea>
          </div>
        )}

        <div class="skjema__felt">
          <label for="tidspunkt-3">Når skal entreprenøren din i gang?</label>
          <select id="tidspunkt-3" name="tidspunkt">
            <option value="innen-3-mnd">Innen 3 mnd</option>
            <option value="3-6-mnd">3–6 mnd</option>
            <option value="6-12-mnd">6–12 mnd</option>
            <option value="ikke-bestemt">Ikke bestemt</option>
          </select>
        </div>

        <div class="skjema__samtykke">
          <input type="checkbox" id="samtykke-3" name="samtykke" required />
          <label for="samtykke-3">
            Ja, noXcuse kan kontakte meg om denne henvendelsen. Vi lagrer opplysningene så lenge
            det er nødvendig for å følge den opp, og deler dem ikke med andre enn selskapene som
            er involvert i leveransen. Du kan be om innsyn eller sletting når som helst.
          </label>
        </div>

        <button type="submit" class="skjema__knapp">Send inn</button>

        <p class="skjema__under">
          Vi svarer med pris på huset og på hver enkelt tjeneste du har krysset av. Du får se hva
          hver post koster, ikke bare summen.
        </p>
      </form>
    </div>
  </section>

  <SegmentBytte gjeldende="egen-entreprenor" />
</Side>

<style>
  .hero {
    background-color: var(--color-bomull);
  }
  .hero__inner {
    max-width: var(--spacing-bredde);
    margin-inline: auto;
    padding: var(--spacing-rom-6) var(--spacing-side-x) var(--spacing-rom-4);
  }
  .hero__h1 {
    font-size: var(--text-h2);
    color: var(--color-marine);
    max-width: 24ch;
    margin: 0 0 var(--spacing-rom-3);
  }
  .hero__ingress {
    font-size: var(--text-stor);
    color: var(--color-stein);
    max-width: var(--spacing-bredde-tekst);
    margin: 0;
  }

  .leveranse {
    background-color: var(--color-lin);
  }
  .leveranse__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .leveranse__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .leveranse__tekst {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .leveranse__venter {
    background-color: var(--color-bomull);
    border: 1px solid var(--color-kant);
    border-radius: var(--radius-kort);
    padding: var(--spacing-rom-3);
  }
  .leveranse__venter p {
    margin: 0;
    font-size: var(--text-brod);
    color: var(--color-marine);
  }

  .grensesnitt__venter {
    background-color: var(--color-lin);
    border: 1px solid var(--color-kant);
    border-radius: var(--radius-kort);
    padding: var(--spacing-rom-3);
  }
  .grensesnitt__venter p {
    margin: 0;
    font-size: var(--text-brod);
    color: var(--color-marine);
  }

  .grensesnitt {
    background-color: var(--color-bomull);
  }
  .grensesnitt__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .grensesnitt__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .grensesnitt__lead {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .grensesnitt__liste {
    margin: 0 0 var(--spacing-rom-2);
    padding-left: var(--spacing-rom-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .grensesnitt__liste li {
    font-size: var(--text-brod);
    color: var(--color-marine);
  }
  .grensesnitt__tekst {
    font-size: var(--text-brod);
    color: var(--color-stein);
    margin: 0;
  }

  .garanti {
    background-color: var(--color-lin);
  }
  .garanti__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .garanti__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .garanti__tekst {
    font-size: var(--text-brod);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }

  .skjema {
    background-color: var(--color-bomull);
  }
  .skjema__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x) var(--spacing-rom-6);
  }
  .skjema__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-3);
  }
  .skjema__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-2);
  }
  .skjema__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .skjema__felt {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .skjema__felt label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-liten);
    color: var(--color-marine);
  }
  .skjema__felt input,
  .skjema__felt textarea,
  .skjema__felt select {
    padding: var(--spacing-rom-1) var(--spacing-rom-2);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-knapp);
    background-color: var(--color-bomull);
    color: var(--color-marine);
    font-size: var(--text-brod);
    font-family: var(--font-tekst);
  }
  .skjema__felt input,
  .skjema__felt select {
    min-height: 48px;
  }
  .skjema__felt textarea {
    resize: vertical;
  }
  .skjema__venter {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: 0;
  }
  .skjema__samtykke {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-rom-1);
    margin-top: var(--spacing-rom-1);
  }
  .skjema__samtykke input {
    margin-top: 0.3em;
    flex-shrink: 0;
  }
  .skjema__samtykke label {
    font-size: var(--text-mikro);
    color: var(--color-stein);
  }
  .skjema__knapp {
    min-height: 48px;
    padding: var(--spacing-rom-2) var(--spacing-rom-3);
    border: 1px solid transparent;
    border-radius: var(--radius-knapp);
    background-color: var(--color-marine);
    color: var(--color-bomull);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-brod);
    cursor: pointer;
    transition: background-color var(--tid-nor) var(--ease-brand);
  }
  .skjema__knapp:hover {
    background-color: color-mix(in srgb, var(--color-marine) 88%, black);
  }
  .skjema__under {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: 0;
  }
</style>
