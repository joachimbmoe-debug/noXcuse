---
// Engelsk stubbe for `/kunnskap` — kun i18n-infrastruktur, IKKE oversatt
// innhold. Se astro.config.mjs sin i18n-blokk og MANGLER.md. Dekker kun
// kunnskap-oversikten (`kunnskap/index.astro`) — `kunnskap/[slug].astro` får
// bevisst ingen engelsk stubbe (samlingen er uansett tom, se ticket-instruks
// og MANGLER.md [#44]), språkvelgeren i Nav.astro faller tilbake til /en/
// for de sidene.
import Side from '../../../layouts/Side.astro';
---

<Side title="noXcuse — Knowledge" description="English content for this page is on its way.">
  <section class="stub">
    <div class="stub__inner">
      <h1 class="stub__h1">Knowledge</h1>
      <p class="stub__tekst">
        English content is on its way. In the meantime, please use the
        <a href="/kunnskap">Norwegian version of this page</a>.
      </p>
    </div>
  </section>
</Side>

<style>
  .stub {
    background-color: var(--color-bomull);
  }
  .stub__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-7) var(--spacing-side-x) var(--spacing-rom-6);
  }
  .stub__h1 {
    font-size: var(--text-h2);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-3);
  }
  .stub__tekst {
    font-size: var(--text-stor);
    color: var(--color-stein);
    margin: 0;
  }
  .stub__tekst a {
    color: var(--color-marine);
  }
</style>
