---
// `/mulighetsvurdering` — betalt, full gjennomgang med befaring. Fase 3 steg 13.
// Tilbys ETTER den gratis /kan-du-bygge-her, og i spor 2/3 — aldri som forside-CTA,
// se 03_SALGSFUNNEL.md §7 og 09_TJENESTEMENY.md §6. All tekst kopiert ordrett fra
// 04_TEKST_ALLE_SIDER.md §9b. Skjemafelt fra 03_SALGSFUNNEL.md §9
// ("Mulighetsvurdering — betalt": samme felt som "Kan du bygge her?", pluss
// fritekst og tidspunkt-nedtrekk).
//
// PRIS — kritisk regel, se MANGLER.md #39: prisen er i dag et intervall i
// tjenestemenyen, og et intervall kan ikke stå mot forbruker. Det intervallet
// skal ALDRI publiseres her, i noen form. Prisen rutes derfor
// gjennom faktaEllerPlassholder() akkurat som svartid på /tomta-er-klar —
// viser ⚠️ BEKREFT i dev, stopper bygget i prod. §9b sier selv "Prisen skal
// stå over knappen, ikke under" — derfor egen <section class="pris"> plassert
// FØR skjema-seksjonen, ikke som finskrift under submit-knappen.
//
// Betinget innhold gates på config.TOMTEVURDERING_KLAR (i dag false), samme
// mønster som TJENESTELISTE_KLAR på /vi-tar-resten og GRENSESNITT_RUTINE:
// true-grenen er strukturelt klar for når faktum finnes, false-grenen viser
// generell ventetekst uten å love et tall.
//
// Fratrekk-setningen har to deler: "trekkes fra ved kjøp" er reell tekst,
// men hvorvidt det gjelder privatkunder er ⚠️ BEKREFT i kilden ("i dag står
// det bare for eksterne") — også denne rutes gjennom faktaEllerPlassholder().
import Side from '../layouts/Side.astro';
import { config } from '../config';
import { faktaEllerPlassholder } from '../lib/bekreft';

const prisMV = faktaEllerPlassholder(null, 'Pris for mulighetsvurdering — ett fast beløp inkl. mva, ikke et intervall');
const fratrekkBekreftelse = faktaEllerPlassholder(
  null,
  'Bekreftelse: fratrekk ved kjøp gjelder også privatkunder (i dag bekreftet kun for eksterne)'
);
---

<Side
  title="noXcuse — Mulighetsvurdering av tomt"
  description="Full gjennomgang av tomta med befaring. Du får et skriftlig notat du kan ta med til banken, kommunen eller entreprenøren."
>
  <section class="hero reveal" data-reveal aria-labelledby="hero-h1">
    <div class="hero__inner">
      <h1 id="hero-h1" class="hero__h1">Mulighetsvurdering av tomt</h1>
      <p class="hero__ingress">
        Full gjennomgang av tomta, med befaring. Du får et skriftlig notat du kan ta med til
        banken, kommunen eller entreprenøren.
      </p>
    </div>
  </section>

  {/* Hva vi ser på */}
  <section class="ser-paa reveal" data-reveal aria-labelledby="ser-paa-h2">
    <div class="ser-paa__inner">
      <h2 id="ser-paa-h2" class="ser-paa__h2">Hva vi ser på</h2>
      <ul class="ser-paa__liste">
        <li>Reguleringsplan og hva den tillater</li>
        <li>Utnyttelsesgrad og byggegrenser</li>
        <li>Adkomst for trailer og kran — dette avgjør ofte alt, og få tenker på det</li>
        <li>Grunnforhold og fall, så langt det kan vurderes uten grunnundersøkelse</li>
        <li>Avstand til vann, avløp og strøm</li>
        <li>Hvilke modeller som passer</li>
        <li>Grov økonomi</li>
      </ul>
    </div>
  </section>

  {/* Pris — skal stå over knappen, ikke under. Se filkommentar. */}
  <section class="pris reveal" data-reveal aria-labelledby="pris-h2">
    <div class="pris__inner">
      <h2 id="pris-h2" class="pris__h2">Pris</h2>
      {config.TOMTEVURDERING_KLAR ? (
        <p class="pris__belop">{prisMV}</p>
      ) : (
        <div class="pris__venter">
          <p class="pris__belop">{prisMV}</p>
          <p>Vi oppgir alltid ett fast beløp inkl. mva før du bestiller — aldri et intervall.</p>
        </div>
      )}
      <p class="pris__fratrekk">
        Bestiller du hus av oss etterpå, trekkes vurderingen fra. {fratrekkBekreftelse}
      </p>
    </div>
  </section>

  {/* Skjema — felt fra 03_SALGSFUNNEL.md §9: samme felt som /kan-du-bygge-her,
      pluss fritekst og tidspunkt-nedtrekk. */}
  <section class="skjema reveal" data-reveal aria-labelledby="skjema-h2">
    <div class="skjema__inner">
      <h2 id="skjema-h2" class="skjema__h2">Bestill mulighetsvurdering</h2>

      <form
        class="skjema__form"
        name="mulighetsvurdering"
        method="POST"
        data-netlify="true"
        netlify-honeypot="firmanavn"
        action="/takk"
      >
        <input type="hidden" name="form-name" value="mulighetsvurdering" />

        <div class="skjema__honeypot" aria-hidden="true">
          <label for="firmanavn-mv">La stå tomt</label>
          <input type="text" id="firmanavn-mv" name="firmanavn" tabindex="-1" autocomplete="off" />
        </div>

        <div class="skjema__felt">
          <label for="navn-mv">Navn</label>
          <input type="text" id="navn-mv" name="navn" autocomplete="name" required />
        </div>

        <div class="skjema__felt">
          <label for="epost-mv">E-post</label>
          <input type="email" id="epost-mv" name="epost" autocomplete="email" required />
        </div>

        <div class="skjema__felt">
          <label for="telefon-mv">Telefon</label>
          <input type="tel" id="telefon-mv" name="telefon" autocomplete="tel" />
        </div>

        <div class="skjema__felt">
          <label for="adresse-mv">Adresse på tomta</label>
          <input type="text" id="adresse-mv" name="adresse" autocomplete="street-address" />
        </div>

        <div class="skjema__felt">
          <label for="gnrbnr-mv">Gnr/bnr</label>
          <input type="text" id="gnrbnr-mv" name="gnr-bnr" />
          <p class="skjema__hjelpetekst">Fyll ut minst ett av adresse eller gnr/bnr — vi trenger det for å finne tomta.</p>
        </div>

        <div class="skjema__felt">
          <label for="kommune-mv">Kommune</label>
          <input type="text" id="kommune-mv" name="kommune" autocomplete="address-level2" required />
        </div>

        <fieldset class="skjema__fieldset">
          <legend>Har du tomta i dag?</legend>
          <label class="skjema__radio"><input type="radio" name="har-tomta" value="ja" required /> Ja</label>
          <label class="skjema__radio"><input type="radio" name="har-tomta" value="ser-etter" /> Nei, ser etter</label>
          <label class="skjema__radio"><input type="radio" name="har-tomta" value="arver-deler" /> Arver eller deler fra</label>
        </fieldset>

        <div class="skjema__felt">
          <label for="fritekst-mv">Hva ser du for deg?</label>
          <textarea id="fritekst-mv" name="hva-ser-du-for-deg" rows="4"></textarea>
        </div>

        <div class="skjema__felt">
          <label for="tidspunkt-mv">Når ønsker du å bygge?</label>
          <select id="tidspunkt-mv" name="naar-bygge">
            <option value="innen-6-mnd">Innen 6 mnd</option>
            <option value="6-12-mnd">6–12 mnd</option>
            <option value="1-2-aar">1–2 år</option>
            <option value="vet-ikke">Vet ikke</option>
          </select>
        </div>

        <div class="skjema__samtykke">
          <input type="checkbox" id="samtykke-mv" name="samtykke" required />
          <label for="samtykke-mv">
            Ja, noXcuse kan kontakte meg om denne henvendelsen. Vi lagrer opplysningene så lenge
            det er nødvendig for å følge den opp, og deler dem ikke med andre enn selskapene som
            er involvert i leveransen. Du kan be om innsyn eller sletting når som helst.
          </label>
        </div>

        <button type="submit" class="skjema__knapp">Bestill mulighetsvurdering</button>
      </form>
    </div>
  </section>
</Side>

<style>
  .hero {
    background-color: var(--color-bomull);
  }
  .hero__inner {
    max-width: var(--spacing-bredde);
    margin-inline: auto;
    padding: var(--spacing-rom-6) var(--spacing-side-x) var(--spacing-rom-4);
  }
  .hero__h1 {
    font-size: var(--text-h2);
    color: var(--color-marine);
    max-width: 24ch;
    margin: 0 0 var(--spacing-rom-3);
  }
  .hero__ingress {
    font-size: var(--text-stor);
    color: var(--color-stein);
    max-width: var(--spacing-bredde-tekst);
    margin: 0;
  }

  .ser-paa {
    background-color: var(--color-lin);
  }
  .ser-paa__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
  }
  .ser-paa__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }
  .ser-paa__liste {
    margin: 0;
    padding-left: var(--spacing-rom-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .ser-paa__liste li {
    font-size: var(--text-brod);
    color: var(--color-marine);
  }

  .pris {
    background-color: var(--color-bomull);
  }
  .pris__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-kort);
  }
  .pris__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-mikro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gull-tekst);
    margin: 0 0 var(--spacing-rom-2);
  }
  .pris__venter {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .pris__belop {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0;
  }
  .pris__venter p:not(.pris__belop) {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: 0;
  }
  .pris__fratrekk {
    font-size: var(--text-liten);
    color: var(--color-stein);
    margin: var(--spacing-rom-2) 0 0;
    padding-top: var(--spacing-rom-2);
    border-top: 1px solid var(--color-kant);
  }

  .skjema {
    background-color: var(--color-lin);
  }
  .skjema__inner {
    max-width: var(--spacing-bredde-tekst);
    margin-inline: auto;
    padding: var(--spacing-rom-5) var(--spacing-side-x) var(--spacing-rom-6);
  }
  .skjema__h2 {
    font-size: var(--text-h3);
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-3);
  }
  .skjema__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-2);
  }
  .skjema__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .skjema__felt {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }
  .skjema__felt label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-liten);
    color: var(--color-marine);
  }
  .skjema__felt input,
  .skjema__felt textarea,
  .skjema__felt select {
    padding: var(--spacing-rom-1) var(--spacing-rom-2);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-knapp);
    background-color: var(--color-bomull);
    color: var(--color-marine);
    font-size: var(--text-brod);
    font-family: var(--font-tekst);
  }
  .skjema__felt input,
  .skjema__felt select {
    min-height: 48px;
  }
  .skjema__felt textarea {
    resize: vertical;
  }
  .skjema__hjelpetekst {
    font-size: var(--text-mikro);
    color: var(--color-stein);
    margin: 0;
  }
  .skjema__fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-rom-2);
    border: 1px solid var(--color-kant-sterk);
    border-radius: var(--radius-knapp);
    padding: var(--spacing-rom-2);
  }
  .skjema__fieldset legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-liten);
    color: var(--color-marine);
    padding: 0 var(--spacing-rom-1);
  }
  .skjema__radio {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-rom-1);
    font-size: var(--text-brod);
    color: var(--color-marine);
  }
  .skjema__samtykke {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-rom-1);
    margin-top: var(--spacing-rom-1);
  }
  .skjema__samtykke input {
    margin-top: 0.3em;
    flex-shrink: 0;
  }
  .skjema__samtykke label {
    font-size: var(--text-mikro);
    color: var(--color-stein);
  }
  .skjema__knapp {
    min-height: 48px;
    padding: var(--spacing-rom-2) var(--spacing-rom-3);
    border: 1px solid transparent;
    border-radius: var(--radius-knapp);
    background-color: var(--color-marine);
    color: var(--color-bomull);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-brod);
    cursor: pointer;
    transition: background-color var(--tid-nor) var(--ease-brand);
  }
  .skjema__knapp:hover {
    background-color: color-mix(in srgb, var(--color-marine) 88%, black);
  }
</style>
