---
// Kostnadstrapp — "den enkeltvis viktigste seksjonen på hele siden" (kunde).
// Tekst kopiert ordrett fra 04_TEKST_ALLE_SIDER.md §1.3 via src/data/leveransenivaa.ts
// (Fase 2, allerede bygget — se den fila for kildekommentarer og tre-token-strukturen
// inkludert/ikkeInkludert/forutsetter).
//
// Trappe-metafor (02_DESIGNSYSTEM.md/04_TEKST §1.3: "hvert trinn litt høyere enn det
// forrige"): på ≥768px stiger kortenes lodrette padding fra trinn 1 til trinn 3, og
// grid-raden bruker align-items: end slik at kortene deler bunnlinje og vokser oppover —
// et bokstavelig trappetrinn i CSS uten ekstra markup. På mobil er alt likt stablet
// (lov å scrolle, i motsetning til Segmentvelger).
//
// Knapp-variant: "gull" er reservert til marine seksjoner ("Kun på marine seksjoner. Én
// per seksjon" — DESIGN.md §6/Knapp). Denne seksjonen ligger på lys bunn (bomull/lin),
// ikke marine — derfor "sekundaer" her, ikke "gull". Se rapport.
//
// Tallteller (02_DESIGNSYSTEM.md §5, punkt 4 — "kun hvis tallene finnes. Ellers
// ingen."): leveransenivaa (../data/leveransenivaa.ts) har ikke noe beløpsfelt —
// hvert trinn har kun navn/beskrivelse/tekst, ingen number-verdi i det hele tatt,
// ikke engang som plassholder. Det finnes derfor ingenting å telle opp her ennå.
// src/scripts/reveal.js har en generisk, betinget tallteller-funksjon klar
// ([data-teller]-attributt) som kan brukes den dagen et nivå får et ekte
// belopInkMva-felt (samme mønster som Prisboks.astro/tjenester.ts) — ikke
// hardkod bort muligheten, bare ikke fyll den med et tall som ikke finnes.
import { leveransenivaa } from '../data/leveransenivaa';
import Knapp from './Knapp.astro';
import { X } from 'lucide-astro';
---

<section class="kostnadstrapp reveal" data-reveal aria-labelledby="kostnadstrapp-h2">
  <div class="kostnadstrapp__indre">
    <div class="kostnadstrapp__intro">
      <h2 id="kostnadstrapp-h2" class="kostnadstrapp__h2">Tre priser. Du velger hvilken som gjelder deg.</h2>
      <p class="kostnadstrapp__ingress">
        Alle som selger hus oppgir én pris. Problemet er at ingen sier hvilken. Vi bruker tre nivåer på alt vi
        selger.
      </p>
    </div>

    <ol class="kostnadstrapp__trapp">
      {leveransenivaa.map((nivaa, i) => (
        <li class="kostnadstrapp__trinn">
          <div class="kostnadstrapp__kort">
            <p class="kostnadstrapp__nummer">Trinn {i + 1}</p>
            <h3 class="kostnadstrapp__navn">{nivaa.navn}</h3>
            <p class="kostnadstrapp__beskrivelse">{nivaa.beskrivelse}</p>

            {nivaa.ikkeInkludert.length > 0 && (
              <div class="kostnadstrapp__vilkaar">
                <p class="kostnadstrapp__vilkaar-etikett">Ikke med</p>
                <ul class="kostnadstrapp__liste">
                  {nivaa.ikkeInkludert.map((punkt) => (
                    <li>
                      <X class="kostnadstrapp__ikon" size={16} stroke-width={1.5} aria-hidden="true" />
                      <span>{punkt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {nivaa.forutsetter && (
              <div class="kostnadstrapp__vilkaar">
                <p class="kostnadstrapp__vilkaar-etikett">Forutsetter</p>
                <p class="kostnadstrapp__forutsetter">{nivaa.forutsetter}.</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="kostnadstrapp__avslutning">
      <p class="kostnadstrapp__avslutning-tekst">
        Du får aldri en pris fra oss uten å få vite hvilket nivå den gjelder.
      </p>
      <Knapp variant="sekundaer" href="/kostnadsguiden">
        Last ned kostnadsguiden — hva som ligger i hvert nivå (PDF)
      </Knapp>
    </div>
  </div>
</section>

<style>
  .kostnadstrapp {
    background-color: var(--color-bomull);
  }

  .kostnadstrapp__indre {
    max-width: var(--spacing-bredde);
    margin-inline: auto;
    padding: var(--spacing-seksjon-y) var(--spacing-side-x);
  }

  .kostnadstrapp__intro {
    max-width: var(--spacing-bredde-tekst);
    margin-bottom: var(--spacing-rom-6);
  }

  .kostnadstrapp__h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-marine);
    margin: 0 0 var(--spacing-rom-2);
  }

  .kostnadstrapp__ingress {
    font-family: var(--font-tekst);
    font-size: var(--text-stor);
    line-height: 1.65;
    color: var(--color-stein);
    margin: 0;
  }

  /* Trappa */
  .kostnadstrapp__trapp {
    list-style: none;
    margin: 0 0 var(--spacing-rom-6);
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-rom-3);
  }

  .kostnadstrapp__kort {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-2);
    background-color: var(--color-bomull);
    border: 1px solid var(--color-kant);
    border-radius: var(--radius-kort);
    padding: var(--spacing-rom-3);
    transition: border-color var(--tid-nor) var(--ease-brand), box-shadow var(--tid-nor) var(--ease-brand);
  }

  .kostnadstrapp__kort:hover {
    border-color: var(--color-kant-sterk);
    box-shadow: var(--shadow-skygge);
  }

  .kostnadstrapp__nummer {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-mikro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stein);
    margin: 0;
  }

  .kostnadstrapp__navn {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-marine);
    margin: 0;
  }

  .kostnadstrapp__beskrivelse {
    font-family: var(--font-tekst);
    font-size: var(--text-brod);
    line-height: 1.65;
    color: var(--color-marine);
    margin: 0;
  }

  .kostnadstrapp__vilkaar {
    margin-top: auto;
    padding-top: var(--spacing-rom-2);
    border-top: 1px solid var(--color-kant);
  }

  .kostnadstrapp__vilkaar-etikett {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-mikro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-stein);
    margin: 0 0 var(--spacing-rom-1);
  }

  .kostnadstrapp__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-rom-1);
  }

  .kostnadstrapp__liste li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-rom-1);
    font-family: var(--font-tekst);
    font-size: var(--text-liten);
    line-height: 1.5;
    color: var(--color-stein);
  }

  .kostnadstrapp__ikon {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-stein);
  }

  .kostnadstrapp__forutsetter {
    font-family: var(--font-tekst);
    font-size: var(--text-liten);
    line-height: 1.5;
    color: var(--color-stein);
    margin: 0;
  }

  .kostnadstrapp__avslutning {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-rom-3);
    padding-top: var(--spacing-rom-5);
    border-top: 1px solid var(--color-kant);
  }

  .kostnadstrapp__avslutning-tekst {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-stor);
    color: var(--color-marine);
    margin: 0;
    max-width: var(--spacing-bredde-tekst);
  }

  /* Desktop: tre kort ved siden av hverandre, trappe-metafor via stigende padding
     og felles bunnlinje (align-items: end) — hvert trinn litt "høyere" enn det forrige. */
  @media (min-width: 768px) {
    .kostnadstrapp__trapp {
      grid-template-columns: repeat(3, 1fr);
      align-items: end;
      gap: var(--spacing-rom-4);
    }

    .kostnadstrapp__trinn:nth-child(2) .kostnadstrapp__kort {
      padding-block: var(--spacing-rom-4);
    }

    .kostnadstrapp__trinn:nth-child(3) .kostnadstrapp__kort {
      padding-block: var(--spacing-rom-5);
      border-width: 2px;
      border-color: var(--color-marine);
    }

    .kostnadstrapp__avslutning {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
