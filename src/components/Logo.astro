---
// Logo — ordmerket noXcuse, gjenbrukt fra den eksisterende statiske siden
// (../Nettside/DESIGN.md §3 "Logoregler — Variant C", besluttet 09.08.2026).
// Instruks fra Joachim: bruk logoen fra Nettside/, ikke finn opp en ny.
//
// To flater bygget her — lys (nav, standard) og marine (footer, .on-dark).
// Tredje tilfellet (nav flytende over fotohero, forsiden) er IKKE en egen
// `flate`-verdi her — Nav.astro sin .nav--over/.is-solid-CSS overstyrer denne
// komponentens interne klasser (.logo-word/.logo-roof/.logo-x) direkte med
// :global(), siden fargene der er dynamiske (avhenger av scroll-tilstand, ikke
// en statisk prop). Se Nav.astro for den faktiske fargelogikken i det tilfellet.
//
// Minstestørrelse: taklinjen skal skjules under 18px ordmerke-høyde. Ordmerket
// står fast på 22px her og krysser aldri den grensen — @media (max-width: 360px)
// beholdes likevel som beskyttelse, per kildens egen begrunnelse.
interface Props {
  flate?: 'lys' | 'marine';
  class?: string;
}
const { flate = 'lys', class: klasse } = Astro.props as Props;
---

<span class={['logo', `logo--${flate}`, klasse].filter(Boolean).join(' ')}>
  <svg class="logo-roof" viewBox="0 0 120 42" aria-hidden="true" focusable="false">
    <path
      d="M8 40 L60 6 L112 40"
      fill="none"
      stroke="currentColor"
      stroke-width="7"
      stroke-linecap="square"
      stroke-linejoin="miter"
    />
  </svg>
  <span class="logo-word">no<span class="logo-x">X</span>cuse</span>
  <span class="logo-tagline">Levert som avtalt</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }

  .logo-roof {
    display: block;
    width: 64px;
    height: 22px;
    margin-bottom: 2px;
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .logo-x {
    font-weight: 800;
  }

  /* Taglinen — gjeninnført 2026-08-12 (Joachim), tidligere fjernet 09.08.2026
     («ren forenkling, ingen erstatning», se DESIGN.md §3-historikk). Følger
     X sin farge, akkurat som taklinjen — «undertekst skal også følge fargen
     til X». */
  .logo-tagline {
    font-family: var(--font-tekst);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Lys flate (standard) — taklinje og tagline følger X sin farge («taket
     skal ha samme farge som X», Joachim 2026-08-12, bekreftet å gjelde
     overalt). X (og dermed taket/taglinen) i gull-sterk — kontrastunntatt
     dekor/lockup-element, en pre-eksisterende avgjørelse fra før denne
     økten (se DESIGN.md §3 "Variant C"), ikke rørt her. Ordmerket i marine
     tekst. */
  .logo--lys .logo-roof,
  .logo--lys .logo-x,
  .logo--lys .logo-tagline {
    color: var(--color-gull-sterk);
  }
  .logo--lys .logo-word {
    color: var(--color-marine);
  }

  /* Marine flate (footer) — taklinje og tagline følger X igjen. X i bomull
     (hvit) — Joachim, 2026-08-12: "dette gjelder når logoen står med blå
     bakgrunn". Ordmerket alene beholder gull-marine (champagne) i denne
     flaten. */
  .logo--marine .logo-roof,
  .logo--marine .logo-x,
  .logo--marine .logo-tagline {
    color: var(--color-bomull);
  }
  .logo--marine .logo-word {
    color: var(--color-gull-marine);
  }

  /* Minstestørrelse — se DESIGN.md-notatet over. Ordmerket krysser aldri denne
     grensen i praksis ved dagens faste 22px, men beholdes som beskyttelse.
     Taglinen skjules i samme brytepunkt — samme trengselsbegrunnelse som
     taklinjen. */
  @media (max-width: 360px) {
    .logo-roof,
    .logo-tagline {
      display: none;
    }
  }
</style>
